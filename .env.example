# Copy this file to .env when a local override is needed.
AUTOFGO_HOST=127.0.0.1
AUTOFGO_PORT=8000
AUTOFGO_LOG_LEVEL=INFO
AUTOFGO_SCENARIO_DIRECTORY=scenarios
# Omit all four bounds to restrict operations to pyautogui's primary screen.
# Set all four to use another monitor or a virtual-desktop rectangle (negative origins allowed).
# AUTOFGO_SCREEN_LEFT=0
# AUTOFGO_SCREEN_TOP=0
# AUTOFGO_SCREEN_WIDTH=1920
# AUTOFGO_SCREEN_HEIGHT=1080
AUTOFGO_OPERATION_TIMEOUT_SECONDS=5.0
AUTOFGO_IMAGE_POLL_INTERVAL_SECONDS=0.1
# Chrome is auto-detected from standard install locations unless overridden.
# AUTOFGO_CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
AUTOFGO_CHROME_PROFILE_DIRECTORY=.autofgo/chrome-profile
AUTOFGO_CHROME_APP_URL=http://127.0.0.1:5173
AUTOFGO_CHROME_WINDOW_LEFT=0
AUTOFGO_CHROME_WINDOW_TOP=0
AUTOFGO_CHROME_WINDOW_WIDTH=200
AUTOFGO_CHROME_WINDOW_HEIGHT=1000
